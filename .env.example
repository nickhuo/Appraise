# `cp .env.example .env` to set up your own key
OPENAI_API_KEY=replace_with_your_api_key

# Optional. These are the defaults used by the app.
# OPENAI_MODEL=gpt-6-sol
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Set this if the Android SDK is not at ~/Library/Android/sdk.
# ANDROID_HOME=/path/to/android/sdk
